{
    "name": "@dylanebert/shallot",
    "version": "0.10.0-next.3",
    "description": "WebGPU game engine for TypeScript: component data and plugins, web and native desktop builds.",
    "sideEffects": [
        "./src/standard/index.ts"
    ],
    "license": "MIT",
    "packageManager": "bun@1.4.3",
    "engines": {
        "bun": ">=1.4.3"
    },
    "author": "Dylan Ebert <dylan.ebert@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dylanebert/shallot.git"
    },
    "homepage": "https://github.com/dylanebert/shallot",
    "bugs": "https://github.com/dylanebert/shallot/issues",
    "keywords": [
        "webgpu",
        "game-engine",
        "ecs"
    ],
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./bun": "./src/project/bun.ts",
        "./testing": {
            "types": "./dist/testing.d.ts",
            "default": "./src/project/testing.js"
        },
        "./tsconfig.json": "./tsconfig.base.json",
        "./extras": "./src/extras/index.ts",
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./src/project/vite.js"
        },
        "./runtime": "./src/engine/runtime/index.ts",
        "./webgpu": "./src/engine/runtime/webgpu.ts",
        "./ecs": "./src/engine/ecs/index.ts",
        "./utils": "./src/engine/utils/index.ts",
        "./app": "./src/engine/app/index.ts",
        "./input": "./src/core/input/index.ts",
        "./mesh": "./src/core/mesh/index.ts",
        "./rendering": "./src/core/rendering/index.ts",
        "./standard/rendering": "./src/standard/rendering/index.ts",
        "./vignette": "./src/extras/vignette/index.ts",
        "./physics": "./src/core/physics/index.ts",
        "./transform": "./src/core/transform/index.ts",
        "./standard/physics": "./src/standard/physics/index.ts"
    },
    "bin": {
        "shallot": "./bin/shallot.ts"
    },
    "files": [
        "src",
        "bin",
        "tsconfig.base.json",
        "crates/audio/pkg",
        "crates/native",
        "assets/icon-1024.png",
        "!assets/branding/**",
        "dist",
        "examples/minimal",
        "examples/first-person",
        "examples/loading-screen",
        "examples/hud",
        "!examples/*/node_modules",
        "!examples/*/build",
        "!examples/*/dist",
        "!src/standard/physics/solver/fixtures",
        "!src/standard/physics/oracle/**",
        "!src/**/*.test.ts",
        "!**/*.oracle.ts",
        "!src/**/*.node.ts",
        "!src/**/*.e2e.ts",
        "!src/**/*.probes.ts",
        "!**/*.fixture.ts",
        "!**/*.gold.json",
        "!**/fixtures",
        "!**/target/**"
    ],
    "scripts": {
        "build": "bun run ./scripts/build.ts",
        "prepare": "bun run ./scripts/tooling.ts",
        "format": "biome check --write",
        "lint": "biome check",
        "test": "bun test --timeout=250"
    },
    "peerDependencies": {
        "playwright": "^1.63.0",
        "webgpu": "^0.6.2",
        "typegpu": "~0.12.6",
        "vite": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "playwright": {
            "optional": true
        },
        "webgpu": {
            "optional": true
        }
    },
    "dependencies": {
        "@types/node": "^26.6.3",
        "@webgpu/types": "^0.1.74",
        "unplugin-typegpu": "~0.12.4"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@babel/parser": "^8.0.6",
        "@biomejs/biome": "^2.5.14",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/bun": "^1.4.3",
        "binaryen": "132.0.0",
        "playwright": "^1.63.0",
        "publint": "0.3.24",
        "svelte": "^5.57.2",
        "typegpu": "~0.12.6",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "webgpu": "^0.6.2"
    }
}
