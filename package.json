{
    "name": "shallot",
    "private": true,
    "workspaces": [
        "packages/*",
        "examples/gym",
        "examples/flows/*",
        "examples/recipes/*",
        "examples/showcase/*"
    ],
    "scripts": {
        "build": "bun run --cwd packages/shallot build",
        "check": "tsc && biome check && eslint . --max-warnings=0 && bun run scripts/check-versions.ts && bun run scripts/check-imports.ts && bun run scripts/check-boundary.ts && bun run scripts/check-docs.ts && bun run scripts/check-pack.ts && bun run scripts/check-scripts.ts && bun run scripts/check-exports.ts && bun run scripts/check-node-import.ts && bun run scripts/check-site.ts && bun run scripts/check-tumble-fp.ts && bun run scripts/check-examples.ts && bun run scripts/format.ts --check",
        "format": "biome check --write && bun run scripts/format.ts",
        "test": "bun test packages/shallot scripts evals site examples/showcase/visualization/test examples/showcase/ocean/test",
        "test:install": "bun run scripts/install-test.ts",
        "test:changed": "bun run scripts/test-changed.ts",
        "test:ocean-realization": "bun test --timeout 20000 ./examples/showcase/ocean/test/realization.oracle.ts",
        "test:ocean-slope": "bun test --timeout 10000 ./examples/showcase/ocean/test/slope.oracle.ts",
        "test:ocean-mesh-inversion": "bun test --timeout 10000 ./examples/showcase/ocean/test/mesh-inversion-sweep.oracle.ts",
        "test:tui-probes": "bun test ./packages/shallot/bin/tui.probes.ts",
        "test:ocean-fold": "FOLD_ENSEMBLE_MODE=full bun test --timeout 30000 ./examples/showcase/ocean/test/fold-anchor.oracle.ts",
        "bench": "bun run scripts/bench.ts",
        "flows": "bun run scripts/flows.ts",
        "recipes": "bun run scripts/recipes.ts",
        "site": "bun run scripts/build-site.ts",
        "demos": "bun run scripts/demos.ts",
        "rum-intake": "bun run scripts/rum-intake-check.ts",
        "local": "bun run scripts/local-test.ts"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/eslint-parser": "^7.29.7",
        "@babel/parser": "^7.29.7",
        "@babel/plugin-syntax-typescript": "^7.29.7",
        "@biomejs/biome": "^2.5.10",
        "@playwright/test": "^1.62.1",
        "@types/jpeg-js": "^0.3.7",
        "@types/pngjs": "^6.0.5",
        "eslint": "^9.39.5",
        "eslint-plugin-typegpu": "~0.12.0",
        "jiti": "^2.7.0",
        "jpeg-js": "^0.4.4",
        "playwright": "^1.62.1",
        "pngjs": "^7.0.0",
        "typescript": "^7.0.2"
    }
}
