{
    "name": "@dylanebert/shallot",
    "version": "0.10.2-next.0",
    "description": "WebGPU game engine for TypeScript: component data and plugins, web and native desktop builds.",
    "sideEffects": [
        "./src/standard/index.ts"
    ],
    "license": "MIT",
    "packageManager": "bun@1.4.3",
    "engines": {
        "bun": ">=1.4.3"
    },
    "author": "Dylan Ebert <dylan.ebert@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dylanebert/shallot.git"
    },
    "homepage": "https://github.com/dylanebert/shallot",
    "bugs": "https://github.com/dylanebert/shallot/issues",
    "keywords": [
        "webgpu",
        "game-engine",
        "ecs"
    ],
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./bun": "./src/project/bun.ts",
        "./testing": {
            "types": "./dist/testing.d.ts",
            "default": "./src/project/testing.js"
        },
        "./tsconfig.json": "./tsconfig.base.json",
        "./extras": "./src/extras/index.ts",
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./src/project/vite.js"
        },
        "./runtime": "./src/engine/runtime/index.ts",
        "./testing/gpu": "./src/project/testing-gpu.ts",
        "./webgpu": "./src/engine/runtime/webgpu.ts",
        "./ecs": "./src/engine/ecs/index.ts",
        "./utils": "./src/engine/utils/index.ts",
        "./app": "./src/engine/app/index.ts",
        "./input": "./src/core/input/index.ts",
        "./audio": "./src/core/audio/index.ts",
        "./standard/audio": "./src/standard/audio/index.ts",
        "./mesh": "./src/core/mesh/index.ts",
        "./rendering": "./src/core/rendering/index.ts",
        "./standard/rendering": "./src/standard/rendering/index.ts",
        "./bloom": "./src/extras/bloom/index.ts",
        "./effect-stack": "./src/extras/effect-stack/index.ts",
        "./vignette": "./src/extras/effect-stack/index.ts",
        "./physics": "./src/core/physics/index.ts",
        "./transform": "./src/core/transform/index.ts",
        "./standard/physics": "./src/standard/physics/index.ts"
    },
    "bin": {
        "shallot": "./bin/shallot.ts"
    },
    "files": [
        "src",
        "bin",
        "tsconfig.base.json",
        "MIGRATION.md",
        "crates/audio/pkg",
        "crates/native",
        "assets/icon-1024.png",
        "!assets/branding/**",
        "dist",
        "examples/minimal",
        "examples/first-person",
        "examples/view-model",
        "examples/loading-screen",
        "examples/embedded-scene",
        "examples/day-night-cycle",
        "examples/hud",
        "examples/post-processing",
        "examples/bloom",
        "examples/ambient-occlusion",
        "examples/color-grading",
        "examples/tonemapping",
        "examples/interact",
        "examples/world-ui",
        "examples/save-and-load",
        "examples/particles",
        "examples/volumetric-fog",
        "examples/physics",
        "examples/city",
        "examples/voxel",
        "examples/lit-interior",
        "examples/sound",
        "examples/materials",
        "!examples/*/node_modules",
        "!examples/*/dist",
        "!examples/*/build",
        "!examples/*/.artifacts",
        "!examples/**/test-results",
        "!src/standard/physics/solver/fixtures",
        "!src/standard/physics/oracle/**",
        "!src/extras/bloom/bevy/**",
        "!src/extras/effect-stack/bevy/**",
        "!src/core/rendering/bevy/**",
        "!src/core/rendering/blender/**",
        "!src/**/*.test.ts",
        "!**/*.oracle.ts",
        "!src/**/*.node.ts",
        "!src/**/*.e2e.ts",
        "!src/**/*.probes.ts",
        "!**/*.fixture.ts",
        "!**/*.gold.json",
        "!examples/physics/tests/*.gold.txt",
        "!examples/physics/tests/*.parity.node.ts",
        "!**/fixtures",
        "!**/target/**"
    ],
    "scripts": {
        "build": "bun run ./scripts/build.ts",
        "prepare": "bun run ./scripts/tooling.ts",
        "format": "biome check --write",
        "lint": "biome check",
        "test": "bun test --preload ./scripts/test-timeout.ts"
    },
    "peerDependencies": {
        "wrangler": "4.151.3",
        "playwright": "^1.64.1",
        "webgpu": "^0.6.2",
        "typegpu": "~0.12.8",
        "vite": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "wrangler": {
            "optional": true
        },
        "playwright": {
            "optional": true
        },
        "webgpu": {
            "optional": true
        }
    },
    "dependencies": {
        "@types/node": "^26.6.5",
        "@webgpu/types": "^0.1.74",
        "am-i-vibing": "0.5.0",
        "ci-info": "4.4.0",
        "unplugin-typegpu": "~0.12.6"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@babel/parser": "^8.0.7",
        "@biomejs/biome": "^2.5.15",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/bun": "^1.4.3",
        "@types/semver": "7.8.0",
        "binaryen": "132.0.0",
        "playwright": "^1.64.1",
        "publint": "0.3.25",
        "semver": "7.8.5",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "typegpu": "~0.12.8",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "webgpu": "^0.6.2",
        "wrangler": "4.151.3"
    }
}
