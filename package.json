{
    "name": "@dylanebert/shallot",
    "version": "0.10.0-next.2",
    "description": "WebGPU game engine for TypeScript: component data and plugins, web and native desktop builds.",
    "sideEffects": [
        "./src/standard/index.ts"
    ],
    "license": "MIT",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.2"
    },
    "author": "Dylan Ebert <dylan.ebert@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dylanebert/shallot.git"
    },
    "homepage": "https://github.com/dylanebert/shallot",
    "bugs": "https://github.com/dylanebert/shallot/issues",
    "keywords": [
        "webgpu",
        "game-engine",
        "ecs"
    ],
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./bun": "./src/project/bun.ts",
        "./tsconfig.json": "./tsconfig.base.json",
        "./extras": "./src/extras/index.ts",
        "./brand": "./src/standard/loading/brand.ts",
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./runtime": "./src/engine/runtime/index.ts",
        "./ecs": "./src/engine/ecs/index.ts",
        "./utils": "./src/engine/utils/index.ts",
        "./app": "./src/engine/app/index.ts",
        "./input": "./src/core/input/index.ts",
        "./rendering": "./src/core/rendering/index.ts",
        "./standard/rendering": "./src/standard/rendering/index.ts",
        "./glaze": "./src/transitional/glaze/index.ts",
        "./physics": "./src/transitional/physics/index.ts",
        "./character": "./src/transitional/character/index.ts",
        "./bvh": "./src/transitional/bvh/index.ts"
    },
    "bin": {
        "shallot": "./bin/shallot.ts"
    },
    "files": [
        "src",
        "bin",
        "tsconfig.base.json",
        "crates/audio/pkg",
        "crates/native",
        "assets/icon-1024.png",
        "dist",
        "examples/first-person",
        "examples/loading-screen",
        "!examples/AGENTS.md",
        "!examples/*/node_modules",
        "!examples/*/build",
        "!examples/*/dist",
        "!src/transitional/physics/solver/fixtures",
        "!src/transitional/physics/oracle/**",
        "!**/*.test.ts",
        "!**/*.oracle.ts",
        "!**/*.node.ts",
        "!**/*.e2e.ts",
        "!**/*.probes.ts",
        "!**/*.fixture.ts",
        "!**/*.gold.json",
        "!**/fixtures",
        "!**/target/**"
    ],
    "scripts": {
        "build": "bun run ./scripts/build.ts",
        "prepare": "bun run ./scripts/tooling.ts",
        "check": "bun run scripts/check.ts",
        "format": "biome check --write && bun run scripts/examples-index.ts",
        "test": "bun test --timeout=250",
        "test:browser": "sh scripts/browser.sh"
    },
    "peerDependencies": {
        "bun-webgpu": ">=0.1.7",
        "typegpu": "~0.12.6",
        "vite": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "bun-webgpu": {
            "optional": true
        }
    },
    "dependencies": {
        "@types/node": "^26.6.3",
        "@webgpu/types": "^0.1.74",
        "unplugin-typegpu": "~0.12.4"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@babel/parser": "^8.0.6",
        "@biomejs/biome": "^2.5.14",
        "@types/bun": "^1.4.2",
        "binaryen": "132.0.0",
        "bun-webgpu": "github:dylanebert/bun-webgpu#7b75d0440d2f22e2c9a1cb383d15529652c53d98",
        "playwright": "^1.63.0",
        "publint": "0.3.24",
        "typegpu": "~0.12.6",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "webgpu": "^0.6.1"
    }
}
