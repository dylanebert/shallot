{
    "name": "@dylanebert/shallot",
    "version": "0.10.0",
    "description": "WebGPU game engine for TypeScript: scenes as data, behavior as plugins, web and native desktop builds.",
    "sideEffects": [
        "./src/standard/index.ts",
        "./src/standard/defaults.ts"
    ],
    "license": "MIT",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.2"
    },
    "author": "Dylan Ebert <dylan.ebert@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/dylanebert/shallot.git"
    },
    "homepage": "https://github.com/dylanebert/shallot",
    "bugs": "https://github.com/dylanebert/shallot/issues",
    "keywords": [
        "webgpu",
        "game-engine",
        "ecs"
    ],
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./extras": "./src/extras/index.ts",
        "./harness": "./src/harness/index.ts",
        "./harness/check": "./src/harness/check.ts",
        "./harness/surface": "./src/harness/surface.ts",
        "./harness/preload": "./src/harness/preload.ts",
        "./harness/pixels": "./src/harness/pixels.ts",
        "./harness/browser": {
            "types": "./src/harness/browser.d.ts",
            "default": "./src/harness/browser.json"
        },
        "./vite": {
            "types": "./src/project/vite.ts",
            "default": "./dist/vite.js"
        },
        "./runtime": "./src/engine/runtime/index.ts",
        "./ecs": "./src/engine/ecs/index.ts",
        "./utils": "./src/engine/utils/index.ts",
        "./render": "./src/standard/render/index.ts",
        "./sear": "./src/standard/sear/index.ts",
        "./glaze": "./src/standard/glaze/index.ts",
        "./physics": "./src/standard/physics/index.ts",
        "./character": "./src/standard/character/index.ts",
        "./bvh": "./src/standard/bvh/index.ts"
    },
    "bin": {
        "shallot": "./bin/shallot.ts"
    },
    "files": [
        "src",
        "bin",
        "crates/audio/pkg",
        "crates/native",
        "assets/icon-1024.png",
        "dist",
        "examples",
        "!examples/AGENTS.md",
        "!examples/*/node_modules",
        "!examples/*/tsconfig.json",
        "!src/extras/gltf/fixtures",
        "!src/standard/physics/solver/fixtures",
        "scripts/check-surface.ts",
        "scripts/surface.ts",
        "scripts/test-runner.ts",
        "!scripts/check.ts",
        "!scripts/check-pack.ts",
        "!scripts/check-reference-pin.ts",
        "!scripts/generate/**",
        "!scripts/assets.ts",
        "!scripts/png.ts",
        "!scripts/format.ts",
        "!scripts/examples-index.ts",
        "!scripts/tooling.ts",
        "!scripts/audio.ts",
        "!scripts/wasm-opt.ts",
        "!scripts/fixtures/**",
        "shallot.schema.json",
        "!**/*.test.ts",
        "!**/*.oracle.ts",
        "!**/*.probes.ts",
        "!**/*.fixture.ts",
        "!**/*.gold.json",
        "!**/fixtures/**",
        "!**/target/**"
    ],
    "scripts": {
        "build": "bun run ./scripts/build.ts",
        "check": "bun run scripts/check.ts",
        "format": "biome check --write && bun run scripts/format.ts",
        "test": "bun run scripts/test-runner.ts --unit",
        "list": "bun run scripts/surface.ts --list",
        "workflow": "bun run scripts/surface.ts --workflow",
        "assets": "bun run scripts/assets.ts",
        "examples:index": "bun run scripts/examples-index.ts",
        "prepack": "bun run ./scripts/tooling.ts"
    },
    "peerDependencies": {
        "bun-webgpu": ">=0.1.7",
        "playwright": "^1.0.0",
        "typegpu": "~0.12.5"
    },
    "peerDependenciesMeta": {
        "bun-webgpu": {
            "optional": true
        },
        "playwright": {
            "optional": true
        }
    },
    "dependencies": {
        "@babel/parser": "^8.0.4",
        "@types/node": "^26.2.0",
        "@webgpu/types": "^0.1.72",
        "unplugin-typegpu": "~0.12.3",
        "vite": "^8.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@dylanebert/shallot": "link:.",
        "@types/bun": "^1.4.2",
        "binaryen": "132.0.0",
        "bun-webgpu": "github:dylanebert/bun-webgpu#7b75d0440d2f22e2c9a1cb383d15529652c53d98",
        "playwright": "^1.63.0",
        "typegpu": "~0.12.5",
        "typescript": "^7.0.2"
    }
}
