{
    "name": "shallot",
    "private": true,
    "workspaces": [
        "packages/*",
        "examples/gym",
        "examples/flows/*",
        "examples/recipes/*",
        "examples/showcase/*"
    ],
    "scripts": {
        "build": "bun run --cwd packages/shallot build",
        "check": "bun run format && tsc && biome check && eslint . --max-warnings=0 && bun run scripts/check-versions.ts && bun run scripts/check-imports.ts && bun run scripts/check-boundary.ts && bun run scripts/check-docs.ts && bun run scripts/check-pack.ts && bun run scripts/check-scripts.ts",
        "format": "biome check --write && bun run scripts/format.ts",
        "test": "bun test packages/shallot",
        "test:install": "bun run scripts/install-test.ts",
        "bench": "bun run scripts/bench.ts",
        "flows": "bun run scripts/flows.ts",
        "recipes": "bun run scripts/recipes.ts",
        "local": "bun run scripts/local-test.ts"
    },
    "devDependencies": {
        "@babel/core": "^7.28.6",
        "@babel/eslint-parser": "^7.28.6",
        "@babel/plugin-syntax-typescript": "^7.28.5",
        "@biomejs/biome": "^2.5.8",
        "@playwright/test": "^1.58.2",
        "@types/pngjs": "^6.0.5",
        "eslint": "^9.0.0",
        "eslint-plugin-typegpu": "~0.12.0",
        "jiti": "^2.7.0",
        "playwright": "^1.58.2",
        "pngjs": "^7.0.0",
        "typescript": "^7.0.2"
    }
}
