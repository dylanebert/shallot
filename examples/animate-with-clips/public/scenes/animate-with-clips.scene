<scene>
    <a ambient-light="color: 0xd0dcec" />
    <a directional-light="direction: -0.4 -1 -0.55; color: 0xfff4e0; intensity: 1.1" />
    <a camera sear transform orbit="distance: 7; yaw: 0.5; pitch: 0.22" />
    <a part transform="pos: 0 -0.5 0; scale: 8 0.15 8" color="rgba: 0.28 0.3 0.34" />

    <!-- A mixer sequences two keyframe clips; the Animator is the scene's only timeline contact. -->
    <a id="ball" part transform="pos: -1.3 0.6 0" color="rgba: 0.4 0.6 0.95" />
    <a animator="clip: lift; loop: 1; target: @ball" />

    <!-- Script clips use the same registered-playable and Animator contract. -->
    <a id="coin" bounce part transform="pos: 1.3 0.6 0" color="rgba: 0.95 0.75 0.35" />
    <a animator="clip: bounce; loop: 1; target: @coin" />
</scene>
