{
    "name": "first-person",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build",
        "preview": "vite preview --host 127.0.0.1",
        "test": "bun test --timeout=250 && bun run test:node",
        "test:node": "bun test ./tests/*.node.ts ./src/*.node.ts",
        "build:capture": "bun build ./tests/capture-page.ts --target=browser --format=iife --outfile=.artifacts/capture-page.js",
        "test:browser": "bun run build:capture && playwright test"
    },
    "dependencies": {
        "@dylanebert/shallot": "0.10.0-next.3"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "playwright": "^1.63.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "webgpu": "^0.6.2"
    }
}
