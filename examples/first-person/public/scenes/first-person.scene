<scene>
    <a ambient-light="color: 0xd6dfdf; intensity: 0.74" />
    <a directional-light="direction: -0.45 -1 -0.6; color: 0xffe8c7; intensity: 1.1" shadow />

    <!-- the player's eye follows the capsule; the route faces the short steps, lift, and tower -->
    <a id="eye" camera sear transform="pos: 0 2.1 12" />
    <a
        id="player"
        body="pos: 0 1.4 12; shape: 2; half-extents: 0 0.6 0 0.3; mass: 0"
        character
        player="camera: @eye"
    />

    <!-- quiet neutral ground and broad steps give the ascent a clear silhouette from spawn -->
    <a
        id="ground"
        body="pos: 0 0 -5; half-extents: 16 0.5 26; mass: 0"
        part
        color="rgba: 0.15 0.19 0.2"
    />
    <a
        id="step-1"
        body="pos: 0 0.75 3; half-extents: 3 0.25 1.5; mass: 0"
        part
        color="rgba: 0.28 0.34 0.34"
    />
    <a
        id="step-2"
        body="pos: 0 1.25 0; half-extents: 3 0.25 1.5; mass: 0"
        part
        color="rgba: 0.28 0.34 0.34"
    />
    <a
        id="step-3"
        body="pos: 0 1.75 -3; half-extents: 3 0.25 1.5; mass: 0"
        part
        color="rgba: 0.28 0.34 0.34"
    />

    <!-- the single moving object: it starts level with the last step and rises only on Y -->
    <a
        id="lift"
        body="pos: 0 1.75 -6.5; half-extents: 3 0.25 2; mass: 0"
        part
        color="rgba: 0.83 0.53 0.24"
        lift
    />

    <!-- staggered neutral blocks make a compact tower and finish at a readable perch -->
    <a
        id="tower-1"
        body="pos: 0.7 2.5 -10; half-extents: 2.2 0.5 1.2; mass: 0"
        part
        color="rgba: 0.34 0.4 0.39"
    />
    <a
        id="tower-2"
        body="pos: -0.7 3.5 -12.3; half-extents: 1.8 0.5 1.2; mass: 0"
        part
        color="rgba: 0.34 0.4 0.39"
    />
    <a
        id="tower-3"
        body="pos: 0.7 4.5 -14.5; half-extents: 2.2 0.5 1.5; mass: 0"
        part
        color="rgba: 0.39 0.45 0.43"
    />
</scene>
